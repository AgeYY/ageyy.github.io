<div class="col">
  <article class="card h-100">
    {% if project.img %}
      <a href="{{ project.url | relative_url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ project.img | relative_url }}" alt="" loading="lazy" class="card-img-top">
      </a>
    {% endif %}
    <div class="card-body d-flex flex-column">
      <h2 class="card-title h4">
        <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
      </h2>
      <p class="card-text">{{ project.description }}</p>
      <div class="mt-auto d-flex flex-wrap" aria-label="{{ project.title | escape }} links">
        {% if project.demo %}
          <a class="mr-3 mb-2" href="{{ project.demo }}">{{ project.demo_label | default: 'Try it' }}</a>
        {% endif %}
        {% if project.github %}
          <a class="mr-3 mb-2" href="{{ project.github }}"
            >GitHub<span class="sr-only">: {{ project.title }}</span></a
          >
        {% endif %}
        <a class="mb-2" href="{{ project.url | relative_url }}"
          >Read more<span class="sr-only">: {{ project.title }}</span></a
        >
      </div>
    </div>
  </article>
</div>
