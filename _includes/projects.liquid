<article class="project-entry">
  {% if project.img %}
    <a class="project-image" href="{{ project.url | relative_url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ project.img | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
  <div class="project-copy">
    <h2>
      <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
    </h2>
    <p>{{ project.description }}</p>
    <div class="project-links">
      {% if project.demo %}
        <a href="{{ project.demo }}">
          {{- project.demo_label | default: 'Try it' }}
          <span aria-hidden="true">↗</span></a
        >
      {% endif %}
      {% if project.github %}
        <a href="{{ project.github }}"
          >GitHub<span class="sr-only">: {{ project.title }}</span> <span aria-hidden="true">↗</span></a
        >
      {% endif %}
      <a href="{{ project.url | relative_url }}"
        >Read more<span class="sr-only">: {{ project.title }}</span> <span aria-hidden="true">→</span></a
      >
    </div>
  </div>
</article>
