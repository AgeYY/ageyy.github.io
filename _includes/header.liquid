<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav class="site-nav container" aria-label="Main navigation">
    <a class="site-name" href="{{ '/' | relative_url }}">
      {{- site.first_name }}
      {{ site.last_name -}}
    </a>
    <div class="site-nav-links">
      <a
        href="{{ '/' | relative_url }}"
        {% if page.permalink == '/' %}
          aria-current="page"
        {% endif %}
        >About</a
      >
      <a href="{{ '/' | relative_url }}#publications">Publications</a>
      {% assign navigation_pages = site.pages | sort: 'nav_order' %}
      {% for item in navigation_pages %}
        {% if item.nav and item.autogen == null %}
          <a
            href="{{ item.url | relative_url }}"
            {% if page.url contains item.url %}
              aria-current="page"
            {% endif %}
          >
            {{- item.title -}}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>
</header>
