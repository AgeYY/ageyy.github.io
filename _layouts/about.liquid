---
layout: default
---
<div class="home-page">
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">{{ page.intro_role }}</p>
      <h1 id="intro-title">
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p class="intro-research">{{ page.research_intro }}</p>
      <div class="contact-links" aria-label="Contact and profiles">
        <a href="mailto:zeyuanye@hotmail.com">Email <span aria-hidden="true">↗</span></a>
        <a href="https://scholar.google.com/citations?user=qnYcPGoAAAAJ&hl=en">Google Scholar <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/AgeYY">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    {% if page.profile.image %}
      <img
        class="intro-portrait"
        src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}"
        alt="Portrait of Zeyuan Ye"
        width="200"
        height="240"
        fetchpriority="high"
      >
    {% endif %}
  </section>

  <section class="about-section" aria-labelledby="about-title">
    <h2 id="about-title" class="section-label">About</h2>
    <div class="biography">{{ content }}</div>
  </section>

  {% if page.announcements and page.announcements.enabled %}
    <section class="content-section" aria-labelledby="updates-title">
      <div class="section-heading">
        <h2 id="updates-title">Recent updates</h2>
        <a href="{{ '/news/' | relative_url }}">All updates <span aria-hidden="true">↗</span></a>
      </div>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}

  {% if page.selected_papers %}
    <section class="content-section" id="publications" aria-labelledby="publications-title">
      <div class="section-heading">
        <h2 id="publications-title">Selected publications</h2>
        <a href="https://scholar.google.com/citations?user=qnYcPGoAAAAJ&hl=en">All publications <span aria-hidden="true">↗</span></a>
      </div>
      {% include selected_papers.liquid %}
    </section>
  {% endif %}

  <aside class="projects-note">
    <div>
      <h2>Outside the papers</h2>
      <p>Small tools and research ideas I explore for fun.</p>
    </div>
    <a href="{{ '/projects/' | relative_url }}">Explore projects <span aria-hidden="true">→</span></a>
  </aside>
</div>
